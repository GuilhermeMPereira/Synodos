# ---------------------------------------------------------------------------
# Synodos - modelo de variaveis de ambiente
# Copie para .env e preencha. O arquivo .env NAO deve ser versionado.
# ---------------------------------------------------------------------------

# --- Oracle Autonomous Database -------------------------------------------
ORACLE_USER=SYNODOS
ORACLE_PASSWORD=troque_esta_senha
ORACLE_DSN=synodosdb_high
ORACLE_WALLET_DIR=/caminho/para/Wallet_synodosdb
ORACLE_WALLET_PASSWORD=senha_da_wallet

# --- Oracle Select AI ------------------------------------------------------
# Provedor "oci" usa o resource principal do proprio banco: NAO precisa de
# chave de API paga. Regiao sa-saopaulo-1 (Brazil East) e suportada.
SELECT_AI_PROFILE=SYNODOS_AI
SELECT_AI_PROVIDER=oci
SELECT_AI_REGION=sa-saopaulo-1

# Preencha apenas se usar SELECT_AI_PROVIDER=openai
# SELECT_AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-troque-esta-chave

# --- Janela de ingestao ----------------------------------------------------
COMPETENCIA_INICIO=202301
COMPETENCIA_FIM=202412
UFS_PILOTO=TODAS

# --- Geracao de SQL pelo modelo, executado no Oracle ------------------------
# Usado quando a instancia nao consegue chamar o modelo sozinha (Always Free
# nao completa saida HTTP). Aqui quem chama o modelo e a aplicacao; o SQL
# gerado continua sendo executado pelo Autonomous Database.
# Chave gratuita, sem cartao: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Vazio = descobre sozinho o modelo mais recente que a conta enxerga.
# Fixe um nome so se quiser previsibilidade na gravacao do video.
GEMINI_MODEL=
